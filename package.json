{
  "name": "alphakiller",
  "version": "0.1.0-beta.2",
  "description": "Desktop image cleanup tool for transparent pixel and anti-aliasing artifacts.",
  "main": "electron/main.js",
  "type": "module",
  "author": "AlphaKiller",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && electron .\"",
    "test": "node scripts/unit-tests.mjs",
    "verify": "npm test && npm run build && npm run diagnose:perf && npm run diagnose:hf",
    "diagnose:perf": "node scripts/perf-benchmark.mjs",
    "diagnose:hf": "node scripts/hf-access-check.mjs",
    "diagnose:bg-remove": "node scripts/bg-remove-smoke.mjs",
    "diagnose:rmbg2:api": "node scripts/rmbg2-api-smoke.mjs",
    "diagnose:pdf": "node scripts/pdf-export-smoke.mjs",
    "benchmark:bg-remove": "node scripts/bg-remove-benchmark.mjs",
    "build": "vite build",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg --arm64",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --ia32",
    "dist:win:x64": "npm run build && electron-builder --win nsis --x64",
    "dist:win:ia32": "npm run build && electron-builder --win nsis --ia32",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64 --ia32",
    "preview": "vite preview --host 127.0.0.1",
    "electron": "electron ."
  },
  "build": {
    "appId": "com.alphakiller.app",
    "productName": "AlphaKiller",
    "asar": false,
    "afterPack": "scripts/after-pack.cjs",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.ico",
      "build/icon.icns",
      "!**/._*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AlphaKiller",
      "artifactName": "AlphaKiller-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "AlphaKiller-${version}-${arch}.${ext}"
    },
    "mac": {
      "icon": "build/icon.icns",
      "identity": null,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.graphics-design",
      "artifactName": "AlphaKiller-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "utif": "^3.1.0",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "electron": "^39.2.4",
    "electron-builder": "^26.8.1",
    "playwright-core": "^1.59.1",
    "wait-on": "^9.0.1"
  }
}
