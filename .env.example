# Optional development-only Hugging Face token.
# Never commit a real token.
# ALPHAKILLER_HF_TOKEN=your_hugging_face_read_token_here

# Optional hosted RMBG-2.0 provider token.
# Never commit a real token.
# BRIA_API_TOKEN=your_bria_api_token_here

# Optional alternate model probe for `npm run diagnose:hf`.
# HF_MODEL_ID=briaai/RMBG-1.4
